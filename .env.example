# Any OpenAI-compatible provider works. Default: Groq (free tier available).
LLM_API_KEY=your_api_key_here
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-120b

# Other options:
# OpenRouter : LLM_BASE_URL=https://openrouter.ai/api/v1   (pick a model ending in ":free")
# Ollama     : LLM_BASE_URL=http://localhost:11434/v1  LLM_API_KEY=ollama  LLM_MODEL=llama3.2  (runs locally, no account)
# DeepInfra  : LLM_BASE_URL=https://api.deepinfra.com/v1/openai  LLM_MODEL=mistralai/Mistral-Small-24B-Instruct-2501
